{
  "name": "@eventium/backend",
  "private": true,
  "type": "module",
  "comments": {
    "prisma-and-tsx": "Runtime dependencies, not dev tools: the container entrypoint runs `prisma migrate deploy` before serving traffic and the optional seed runs through tsx. Declaring them here is what lets the production image be pruned of devDependencies."
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "clean": "rm -rf dist",
    "seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@eventium/plugin-sdk": "workspace:*",
    "@eventium/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "bullmq": "^5.73.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.8.4",
    "graphql": "^16.10.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "mercurius": "^16.9.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.2"
  }
}
