// Eventium database schema.
// Defines all persistent models for users, plugin instances, events,
// dashboards, dashboard panels, and notification rules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Severity levels for events ingested by plugins.
enum Severity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

/// Platform user role.
enum Role {
  ADMIN
  EDITOR
  VIEWER
}

/// A registered platform user.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(VIEWER)
  /// When true, the user must set a new password before using the app (first
  /// login after seed/admin creation).
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  broadcastLinks BroadcastLink[]
  projects       Project[]

  @@map("users")
}

/// A project — the top-level unit that owns pages, like a Visual Studio solution
/// or a Figma file. Each project has its own type, pages, and (soon) data
/// sources, variables, assets and blueprints. A "dashboard" row is one page of a
/// project (kept named `Dashboard` for broadcast/live compatibility).
model Project {
  id          String   @id @default(cuid())
  name        String
  /// Project-type id (dashboard/site/app/report/blank) — drives the editor focus.
  type        String   @default("dashboard")
  description String   @default("")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  pages Dashboard[]
  nodes Node[]

  @@index([ownerId])
  @@map("projects")
}

/// A file-system node in a project's tree — a folder or a typed file (page,
/// blueprint, data source, script, component, variables, theme…). The `kind`
/// string is resolved to an extension/icon/editor by the frontend file-type
/// registry, so new file types need no schema change. A `page` node's `refId`
/// points at the Dashboard that holds its design; other kinds keep content in
/// `data`.
model Node {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  parentId  String?  @map("parent_id")
  /// Node kind: folder | page | blueprint | datasource | script | component | variables | theme | …
  kind      String
  name      String
  order     Int      @default(0)
  /// For `page` nodes: the Dashboard this file opens.
  refId     String?  @map("ref_id")
  /// Content for non-page files (script/data/variables/…), as JSON.
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Node?   @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Node[]  @relation("NodeChildren")

  @@index([projectId])
  @@index([parentId])
  @@map("nodes")
}

/// A concrete installation of a plugin with its own configuration.
model PluginInstance {
  id        String   @id @default(cuid())
  pluginId  String   @map("plugin_id")
  name      String
  config    Json     @default("{}")
  metadata  Json     @default("{}") /// Dynamic metadata fetched from the plugin's API (projects, event types, webhooks, etc.)
  enabled   Boolean  @default(true)
  syncedAt  DateTime? @map("synced_at") /// Last time metadata was synced from the external API
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events Event[]

  @@index([pluginId])
  @@map("plugin_instances")
}

/// An event produced by a plugin instance.
model Event {
  id               String         @id @default(cuid())
  pluginInstanceId String         @map("plugin_instance_id")
  sourceType       String         @default("") @map("source_type") /// Data-source type (e.g. "gitlab") of the producing instance.
  eventType        String         @map("event_type")
  title            String
  description      String         @default("")
  payload          Json           @default("{}")
  severity         Severity       @default(INFO)
  createdAt        DateTime       @default(now()) @map("created_at")

  pluginInstance PluginInstance @relation(fields: [pluginInstanceId], references: [id], onDelete: Cascade)

  @@index([pluginInstanceId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
  @@map("events")
}

/// A user-configured dashboard that hosts multiple panels.
model Dashboard {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  layout      Json     @default("{}")
  isDefault   Boolean  @default(false) @map("is_default")
  /// Owning project. Nullable during migration; every page gets one via backfill.
  projectId   String?  @map("project_id")
  /// Order of this page within its project.
  pageOrder   Int      @default(0) @map("page_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project        Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blocks         DashboardBlock[]
  broadcastLinks BroadcastLinkDashboard[]

  @@index([projectId])
  @@map("dashboards")
}

/// A single design-layer block on a page. A component instance whose slots are
/// filled with cross-source bindings — no direct plugin-instance coupling.
model DashboardBlock {
  id            String   @id @default(cuid())
  dashboardId   String   @map("dashboard_id")
  componentType String   @map("component_type")
  title         String   @default("")
  slots         Json     @default("{}") /// slotKey -> { values: BoundValue[] }
  options       Json     @default("{}") /// static component options
  position      Json     @default("{\"x\": 0, \"y\": 0}")
  size          Json     @default("{\"w\": 6, \"h\": 4}")
  sortOrder     Int      @default(0) @map("sort_order")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_blocks")
}

/// A rule that triggers notification actions when matching events arrive.
model NotificationRule {
  id           String   @id @default(cuid())
  name         String
  eventPattern String   @map("event_pattern")
  conditions   Json     @default("[]")
  actions      Json     @default("[]")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("notification_rules")
}

/// A public broadcast link that exposes one or more dashboards without authentication.
model BroadcastLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String   @map("created_by")

  dashboards BroadcastLinkDashboard[]
  creator    User                     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("broadcast_links")
}

/// Join table linking broadcast links to their dashboards with ordering.
model BroadcastLinkDashboard {
  id              String @id @default(cuid())
  broadcastLinkId String @map("broadcast_link_id")
  dashboardId     String @map("dashboard_id")
  sortOrder       Int    @default(0) @map("sort_order")

  broadcastLink BroadcastLink @relation(fields: [broadcastLinkId], references: [id], onDelete: Cascade)
  dashboard     Dashboard     @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([broadcastLinkId, dashboardId])
  @@index([broadcastLinkId])
  @@map("broadcast_link_dashboards")
}
