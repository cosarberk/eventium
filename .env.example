# Copy to .env and fill in the secrets. Nothing here is a usable default:
# JWT_SECRET and ENCRYPTION_KEY must be generated per installation, and the
# backend refuses to start on a known example value.
#
#   openssl rand -base64 48

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://eventium:CHANGE_ME@localhost:5432/eventium
# Used by docker-compose to provision Postgres.
POSTGRES_USER=eventium
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eventium

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Backend ────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Signs session cookies. Required, min 32 chars.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Encrypts data-source credentials at rest (AES-256-GCM). Required in
# production; when unset it is derived from JWT_SECRET, which means rotating
# JWT_SECRET would make stored plugin tokens unreadable.
ENCRYPTION_KEY=

# Comma-separated list of allowed CORS origins. No wildcards.
# Not needed when the frontend and API share an origin (the Docker setup).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Hardening ──────────────────────────────────────────
# Mark the session cookie Secure. Defaults to true in production; set false only
# when deliberately serving over plain HTTP (browsers drop the cookie otherwise).
# COOKIE_SECURE=true
# Trust X-Forwarded-* headers (enable behind a reverse proxy).
# TRUST_PROXY=true
# Open /api/auth/register. Off in production; the seed creates the first admin.
# ALLOW_REGISTRATION=false
# Reject webhooks for instances with no webhookSecret configured.
# WEBHOOK_REQUIRE_SECRET=true
# Allow outbound notification webhooks to private/internal addresses (SSRF risk).
# ALLOW_PRIVATE_NETWORK_WEBHOOKS=false
# Request budget per IP per window.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW=1 minute
# AUTH_RATE_LIMIT_MAX=10
# WEBHOOK_RATE_LIMIT_MAX=600
# Days of event history to keep; 0 disables the cleanup job.
# EVENT_RETENTION_DAYS=30
# Maximum GraphQL query depth.
# GRAPHQL_MAX_DEPTH=12

# ─── Webhook ingress ────────────────────────────────────
# Public base URL external services call. Set this in production.
# PUBLIC_URL=https://eventium.example.com
# Only when using the opt-in cloudflared tunnel profile:
# TUNNEL_METRICS_URL=http://cloudflared:2000

# ─── Seed ───────────────────────────────────────────────
ADMIN_EMAIL=admin@eventium.local
ADMIN_NAME=Admin
# Leave empty to have a strong password generated and printed once.
ADMIN_PASSWORD=

# ─── Frontend (build-time) ──────────────────────────────
# Same-origin paths work behind the bundled Nginx and in dev (Vite proxies).
VITE_GRAPHQL_URL=/graphql
VITE_API_BASE_URL=/api
# Empty means "same origin as the page" — correct behind a reverse proxy.
VITE_WS_URL=
