# syntax=docker/dockerfile:1

# ── Base ──────────────────────────────────────────────────
FROM node:22-alpine AS base
# openssl: required by Prisma's query engine on musl.
# libc6-compat: shims glibc symbols some prebuilt native modules expect.
# tini: reaps zombies and forwards SIGTERM so graceful shutdown actually runs.
RUN apk add --no-cache openssl libc6-compat tini \
    && corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
ENV CI=true
# No .git and no need for hooks inside an image build.
ENV HUSKY=0

# ── Fetch dependencies into the pnpm store ────────────────
# `pnpm fetch` needs only the lockfile, so this layer stays cached until a
# dependency actually changes — and it does not require every workspace
# package.json to be enumerated, which is what made the previous version
# silently miss the nexus plugin.
FROM base AS deps
# Toolchain for native modules (argon2) when no musl prebuild is published.
RUN apk add --no-cache --virtual .build-deps python3 make g++
COPY pnpm-lock.yaml ./
RUN pnpm fetch --frozen-lockfile

# ── Build ─────────────────────────────────────────────────
FROM deps AS build
COPY . .
RUN pnpm install --frozen-lockfile --offline
RUN pnpm --filter @eventium/shared build \
    && pnpm --filter @eventium/plugin-sdk build \
    && pnpm --filter @eventium/backend exec prisma generate \
    && pnpm --filter @eventium/backend build
# Plugins ship compiled entry modules; the backend discovers them at startup, so
# their dist/ must exist in the image.
RUN pnpm --filter "./plugins/*" build

# Reduce the tree to what the server actually needs.
#
# `pnpm prune --prod` is not used here: in a workspace it empties the per-package
# node_modules without relinking them, which leaves the image with a populated
# store and no resolvable imports. Reinstalling with --prod rebuilds the link
# farm correctly, from the same offline store, and drops every devDependency.
# `prisma` and `tsx` survive because the backend declares them as runtime
# dependencies — the entrypoint needs both.
RUN rm -rf apps/frontend/node_modules apps/frontend/dist \
           .turbo apps/*/.turbo packages/*/.turbo plugins/*/.turbo \
    && find . -name '*.tsbuildinfo' -delete \
    && pnpm install --frozen-lockfile --offline --prod

# ── Production ────────────────────────────────────────────
FROM base AS production
ENV NODE_ENV=production

# The whole workspace is copied at the same path, in one piece.
#
# Copying only dist/ and package.json per package is tempting but wrong here:
# pnpm resolves dependencies through per-package `node_modules` symlinks into the
# root store, so a hand-picked subset leaves `@eventium/shared` unable to find
# `zod` and the server dies at import time. Keeping the tree intact keeps those
# links valid. `prisma` and `tsx` also stay available, which the entrypoint needs
# for `migrate deploy` and the optional seed.
COPY --from=build --chown=node:node /app /app
COPY --chown=node:node docker/entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh

# Drop privileges: a compromised process should not be able to rewrite the image.
USER node
WORKDIR /app/apps/backend
EXPOSE 4000

# Readiness covers the database and Redis, so an unhealthy container is pulled
# out of rotation instead of serving errors.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["node", "dist/index.js"]
