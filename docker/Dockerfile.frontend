# syntax=docker/dockerfile:1

# ── Base ──────────────────────────────────────────────────
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
ENV CI=true
# No .git and no need for hooks inside an image build.
ENV HUSKY=0

# ── Fetch dependencies into the pnpm store ────────────────
FROM base AS deps
COPY pnpm-lock.yaml ./
RUN pnpm fetch --frozen-lockfile

# ── Build ─────────────────────────────────────────────────
FROM deps AS build
# Vite inlines these at build time. The defaults are same-origin paths, so the
# image works behind any hostname without a rebuild — Nginx proxies /api,
# /graphql and /socket.io to the backend.
ARG VITE_GRAPHQL_URL=/graphql
ARG VITE_WS_URL=
ARG VITE_API_BASE_URL=/api
ENV VITE_GRAPHQL_URL=$VITE_GRAPHQL_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
COPY . .
RUN pnpm install --frozen-lockfile --offline
RUN pnpm --filter @eventium/shared build \
    && pnpm --filter @eventium/frontend build

# ── Serve with Nginx ──────────────────────────────────────
# The unprivileged image runs as uid 101 and listens on 8080, which satisfies
# clusters that reject root containers (Rancher/Kubernetes restricted policies).
FROM nginxinc/nginx-unprivileged:alpine AS production
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/apps/frontend/dist /usr/share/nginx/html
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
